import streamlit as st
import pandas as pd
import plotly.express as px

@st.cache_data
def load_data():
    pop_url = "https://storage.dosm.gov.my/population/population_parlimen.parquet"
    income_url = "https://storage.dosm.gov.my/hies/hh_income_parlimen.parquet"
    poverty_url = "https://storage.dosm.gov.my/hies/hh_poverty_parlimen.parquet"

    df_pop = pd.read_parquet(pop_url)
    df_inc = pd.read_parquet(income_url)
    df_pov = pd.read_parquet(poverty_url)

    for frame in (df_pop, df_inc, df_pov):
        frame["date"] = pd.to_datetime(frame["date"])

    df_pop = df_pop[df_pop["date"].dt.year.between(2020, 2024)]
    df_inc = df_inc[df_inc["date"].dt.year.between(2020, 2024)]
    df_pov = df_pov[df_pov["date"].dt.year.between(2020, 2024)]

    df_pop = df_pop[
        (df_pop["sex"] == "both")
        & (df_pop["age"] == "overall")
        & (df_pop["ethnicity"] == "overall")
    ]

    merged = pd.merge(df_pop, df_inc, on=["date", "state", "parlimen"], how="inner")
    merged = pd.merge(merged, df_pov, on=["date", "state", "parlimen"], how="inner")
    return merged

def get_selangor_data():
    data = load_data()
    result = data[data["state"] == "Selangor"].copy()
    result["date"] = pd.to_datetime(result["date"])
    return result

st.set_page_config(page_title="Selangor Socioeconomic Dashboard", page_icon="📊", layout="wide")

st.title("Page 3: Mean Household Income Comparison")
st.markdown(
    "This page compares mean household income across parliamentary "
    "constituencies in Selangor between 2022 and 2024."
)

try:
    df_selangor = get_selangor_data()
    df_selangor["year"] = df_selangor["date"].dt.year.astype(str)
    df_selangor = df_selangor[df_selangor["year"].isin(["2022", "2024"])].copy()

    if df_selangor.empty:
        st.warning("No records were found for 2022 and 2024.")
    else:
        sort_order = (
            df_selangor[df_selangor["year"] == "2024"]
            .sort_values("income_mean", ascending=False)["parlimen"]
            .tolist()
        )

        fig = px.bar(
            df_selangor,
            x="income_mean",
            y="parlimen",
            color="year",
            barmode="group",
            orientation="h",
            text="income_mean",
            category_orders={"parlimen": sort_order, "year": ["2022", "2024"]},
            color_discrete_sequence=["#9ECAE1", "#2171B5"],
            title="Comparison of Mean Household Income Across Parliamentary Constituencies in Selangor (2022 vs 2024)",
            labels={
                "income_mean": "Mean Household Income (RM)",
                "parlimen": "Parliamentary Constituency",
                "year": "Year"
            },
            hover_data={
                "income_mean": ":,.0f",
                "income_median": ":,.0f",
                "poverty_absolute": ":.2f"
            }
        )
        fig.update_traces(texttemplate="RM %{x:,.0f}", textposition="outside", cliponaxis=False)
        fig.update_layout(
            template="plotly_white",
            title_x=0.5,
            height=max(700, len(sort_order) * 36),
            bargap=0.25,
            margin=dict(l=150, r=100, t=100, b=60),
            xaxis_title="Mean Household Income (RM)",
            yaxis_title="Parliamentary Constituency",
            legend_title="Year",
            hoverlabel=dict(bgcolor="white", font_size=12),
            xaxis=dict(showgrid=True, gridcolor="lightgrey")
        )
        st.plotly_chart(fig, use_container_width=True)
        st.caption("Source: Department of Statistics Malaysia (DOSM).")
except Exception as e:
    st.error("Unable to display this visualization. Please check the dataset and column names.")
    st.exception(e)
